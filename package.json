{
  "name": "macro-tracker",
  "version": "0.1.0",
  "description": "Track food, macros and micronutrients against goals derived from your body",
  "private": true,
  "license": "MIT",
  "packageManager": "yarn@4.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --port 3014",
    "build": "next build",
    "start": "next start --port 3014",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "prepare": "husky"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@tabler/icons-react": "3.46.0",
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.1.6",
    "next-themes": "0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shadcn": "4.21.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "husky": "^9.1.7",
    "typescript": "^5"
  }
}
