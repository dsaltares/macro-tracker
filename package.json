{
  "name": "macro-tracker",
  "version": "0.1.0",
  "description": "Track food, macros and micronutrients against goals derived from your body",
  "private": true,
  "license": "MIT",
  "packageManager": "yarn@4.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --port 3014",
    "build": "next build",
    "start": "next start --port 3014",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run --project unit --coverage && vitest run --project ui",
    "test:watch": "vitest",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env scripts/migrate.ts",
    "db:backup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env scripts/backup-database.ts",
    "db:import-foods": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env scripts/import-foods.ts",
    "db:copy-down": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env scripts/copy-down.ts",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:dev": "E2E_SERVER=dev playwright test"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@tabler/icons-react": "3.46.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "5.103.1",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "@trpc/tanstack-react-query": "11.19.0",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "kysely": "0.29.6",
    "next": "16.1.6",
    "next-themes": "0.4.6",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shadcn": "4.21.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "@tanstack/react-query-devtools": "^5.103.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.1",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "msw": "^2.15.0",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
